# =============================================================================
# Plantilla de variables de entorno para LaLiga Fantasy
# Copia este archivo como `.env` y rellena los valores correspondientes.
# NUNCA compartas ni subas tu archivo `.env` al repositorio.
# =============================================================================

# Supabase (Base de datos Postgres)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# Azure AD B2C (Autenticación LaLiga - Valores verificados)
B2C_TENANT="login.laliga.es"
# Dominio del tenant B2C que va en la ruta del endpoint de token
B2C_TENANT_DOMAIN="laligadspprob2c.onmicrosoft.com"
B2C_POLICY="B2C_1A_5ULAIP_PARAMETRIZED_SIGNIN"
B2C_CLIENT_ID="6457fa17-1224-416a-b21a-ee6ce76e9bc0"
B2C_SCOPE="6457fa17-1224-416a-b21a-ee6ce76e9bc0 openid offline_access"

# Login interactivo (scripts/login.py): cliente de la app móvil. Valores verificados,
# solo hace falta tocarlos si LaLiga los cambia.
# B2C_LOGIN_CLIENT_ID="af88bcff-1157-40a0-b579-030728aacf0b"
# B2C_LOGIN_REDIRECT_URI="authredirect://com.lfp.laligafantasy"
# B2C_LOGIN_SCOPE="openid offline_access"

# Liga Privada. Vacío = el job diario recolecta TODAS las ligas de tu cuenta.
# Para limitarlo, IDs separados por comas (los lista `python scripts/login.py`).
FANTASY_LEAGUE_ID=""

# Almacén de Tokens
# Ruta local al archivo JSON de token (desarrollo local)
FANTASY_TOKEN_PATH="secrets/token.json"
# En CI (GitHub Actions) se inyecta el JSON serializado como variable de entorno:
# FANTASY_TOKEN_JSON='{"access_token":"...","refresh_token":"...","expires_on":...}'

# Contraseña del dashboard. Vacía = sin contraseña (uso local). En Streamlit Cloud
# ponla siempre en los secrets: el panel puede pagar cláusulas con tu cuenta.
# APP_PASSWORD="una-contraseña-larga"
